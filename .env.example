# LLM_API_KEY is required; everything else has a working default.

# ---- answer generation (required) ------------------------------------------
# Any OpenAI-compatible endpoint. A key is required — the client exits at startup
# without one rather than starting up and refusing every question.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ---- routing ---------------------------------------------------------------
# One call settles intent, tool choice and the search queries. That is
# classification, not prose, so it runs on a smaller model than generation.
# Leave empty to reuse LLM_MODEL — do that if LLM_BASE_URL points at Ollama,
# vLLM or Gemini, where an OpenAI model name would 404 on every turn and
# silently degrade every routing decision to its rule fallback.
ROUTER_MODEL=gpt-4o-mini

# Gemini (OpenAI compatibility layer)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# Local Ollama — no network needed
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# auto detects a usable key; api trusts the key as given
LLM_MODE=auto

# ---- retrieval -------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_FINAL=5
# Calibrated, not guessed: run `make calibrate` after every crawl. The corpus now
# spans a short live site and a long archived one, and the threshold moves with
# it — re-running this is not optional after re-indexing.
MIN_SCORE=0.855

# ---- transport & ports -----------------------------------------------------
# stdio: the client spawns the server (default, and what Claude Desktop uses)
# http:  run the server separately, e.g. on another machine
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
CLIENT_PORT=8000
